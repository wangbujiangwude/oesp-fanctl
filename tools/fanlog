#!/bin/bash
# ============================================================
#  fanlog —— OESP 风扇实时温度 / 状态监控
#
#  背景：装了 oesp-fanctl 应用后，旧的 /usr/local/bin/fanctl.sh
#        已被接管停用，/var/log/fan/fanctl.log 不再更新。
#        本命令用来替代旧的  tail -f /var/log/fan/fanctl.log
#
#  用法：
#     fanlog           前台实时刷新（默认 3 秒一行，Ctrl+C 退出）
#     fanlog 1         前台实时刷新，间隔 1 秒
#     fanlog -f [间隔] 追加写入 /var/log/fan/fanctl.log（可配合后台运行）
#     fanlog -h        显示帮助
# ============================================================
set -u

CPU_NODE=/sys/class/thermal/thermal_zone0/temp
GPU_NODE=/sys/class/thermal/thermal_zone1/temp
OLD_LOG=/var/log/fan/fanctl.log

# 路径自动发现：兼容 appcenter 注入的 /var/apps/<app>/ 视图与真实卷路径
find_first() { local p; for p in "$@"; do [ -e "$p" ] && { printf '%s' "$p"; return; }; done; printf '%s' "$1"; }
STATE=$(find_first /var/apps/oesp-fanctl/var/oesp-fanctl.state \
                   /vol1/@appdata/oesp-fanctl/oesp-fanctl.state)
CONF=$(find_first  /var/apps/oesp-fanctl/etc/oesp-fanctl.conf \
                   /vol1/@appconf/oesp-fanctl/oesp-fanctl.conf)

usage() {
    sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

# 毫摄氏度 -> 43.5
fmt_t() {
    local v
    [ -r "$1" ] || { printf '?'; return; }
    v=$(cat "$1" 2>/dev/null) || { printf '?'; return; }
    case "$v" in ''|*[!0-9-]*) printf '?'; return ;; esac
    printf '%d.%d' $((v / 1000)) $(((v % 1000) / 100))
}

# 从 state 文件取某个 key 的值
sv() { grep -o "$1=[^[:space:]]*" "$STATE" 2>/dev/null | head -1 | cut -d= -f2; }

# 风扇状态：优先读 state 文件（守护进程自己写的，最准），其次实读 GPIO 电平
fan_state() {
    local v
    v=$(sv fan_state)
    if [ -z "$v" ]; then
        v=$(gpioget "$(sv gpio_chip || echo gpiochip0)" "$(sv gpio_line || echo 45)" 2>/dev/null | tr -dc '0-9' | head -c1)
    fi
    printf '%s' "${v:-?}"
}

# 运行模式：auto / on / off
fan_mode() {
    case "$(sv mode)" in
        on)  printf '常开' ;;
        off) printf '常关' ;;
        auto) printf '自动' ;;
        *)   printf '?' ;;
    esac
}

# 硬盘最高温（state 里由守护进程写入）
disk_t() {
    local v; v=$(sv disk_max)
    printf '%s' "${v:-?}"
}

line() {
    printf '[%s] 温度=%s℃ GPU=%s℃ 硬盘=%s℃ 风扇=%s 模式=%s\n' \
        "$(date '+%F %T')" \
        "$(fmt_t "$CPU_NODE")" \
        "$(fmt_t "$GPU_NODE")" \
        "$(disk_t)" \
        "$(fan_state)" \
        "$(fan_mode)"
}

case "${1:-}" in
    -h|--help|help) usage ;;
    -f|--file)
        shift
        iv="${1:-3}"
        while :; do
            line >> "$OLD_LOG"
            sleep "$iv"
        done
        ;;
    *)
        iv="${1:-3}"
        echo "OESP 风扇实时监控（间隔 ${iv}s，Ctrl+C 退出）"
        echo "数据来源: $STATE"
        echo "运行模式: $(fan_mode)（auto=自动温控 / on=常开 / off=常关）"
        echo "CPU开启/关闭阈值: $(grep -oE '^TEMP_(ON|OFF)=[0-9]+' "$CONF" 2>/dev/null | tr '\n' ' ')"
        while :; do
            line
            sleep "$iv"
        done
        ;;
esac
