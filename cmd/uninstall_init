#!/bin/bash
# 卸载前：停止守护进程（并释放 GPIO，避免残留 gpioset 占着引脚）
PID_FILE="${TRIM_PKGVAR}/oesp-fanctl.pid"
if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE" | tr -d '[:space:]')
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    sleep 1
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null
    rm -f "$PID_FILE"
fi
# 结束可能残留的 gpioset 常驻进程
pkill -f 'gpioset -m signal gpiochip0' 2>/dev/null
exit 0
