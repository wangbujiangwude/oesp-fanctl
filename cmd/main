#!/bin/bash
# oesp-fanctl 生命周期脚本（fnOS 调用：start/stop/status）
PID_FILE="${TRIM_PKGVAR}/oesp-fanctl.pid"
DAEMON="${TRIM_APPDEST}/oesp-fanctl"

export OESP_FANCTL_CONF="${TRIM_PKGETC}/oesp-fanctl.conf"
export OESP_FANCTL_LOG="${TRIM_PKGVAR}/oesp-fanctl.log"
export OESP_FANCTL_STATE="${TRIM_PKGVAR}/oesp-fanctl.state"
export OESP_FANCTL_HISTORY="${TRIM_PKGVAR}/history.csv"
# Web 监控页走 fnOS 统一网关（Unix Socket），桌面图标经 /app/oesp-fanctl 访问
export OESP_FANCTL_SOCK="${TRIM_APPDEST}/target/app.sock"
export OESP_FANCTL_BASE="/app/oesp-fanctl"
mkdir -p "${TRIM_APPDEST}/target" 2>/dev/null

err_log() { [ -n "$TRIM_TEMP_LOGFILE" ] && echo "$1" >> "$TRIM_TEMP_LOGFILE"; }

is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid=$(cat "$PID_FILE" | tr -d '[:space:]')
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "$1" in
    start)
        if is_running; then exit 0; fi
        if [ ! -f "$OESP_FANCTL_CONF" ]; then
            cp "${TRIM_APPDEST}/oesp-fanctl.conf.default" "$OESP_FANCTL_CONF" 2>/dev/null
        fi
        chmod +x "$DAEMON" 2>/dev/null
        nohup "$DAEMON" daemon >> "$OESP_FANCTL_LOG" 2>&1 &
        echo $! > "$PID_FILE"
        sleep 2
        if is_running; then
            exit 0
        else
            err_log "oesp-fanctl 启动失败，请检查日志: $OESP_FANCTL_LOG"
            rm -f "$PID_FILE"
            exit 1
        fi
        ;;
    stop)
        if is_running; then
            kill "$(cat "$PID_FILE" | tr -d '[:space:]')" 2>/dev/null
            sleep 1
        fi
        is_running && kill -9 "$(cat "$PID_FILE" | tr -d '[:space:]')" 2>/dev/null
        rm -f "$PID_FILE"
        # 释放 GPIO 并恢复系统自带风扇控制（避免停服后风扇失去温控）
        [ -x "$DAEMON" ] && "$DAEMON" restore >> "$OESP_FANCTL_LOG" 2>&1
        exit 0
        ;;
    status)
        if is_running; then exit 0; fi
        rm -f "$PID_FILE"
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
