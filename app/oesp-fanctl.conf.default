# oesp-fanctl 配置文件（OESP / OES Plus 机型）
# 修改后无需重启服务，守护进程 2 秒内自动读取生效

# 运行模式：auto = 自动温控（按下面阈值启停）
#           on   = 常开，风扇一直运行，忽略所有温度判定（夏季高温 / 硬盘密集 / 求稳）
#           off  = 常关，风扇一直停止，忽略所有温度判定（夜间静音）
# 也可用命令切换：oesp-fanctl mode on   /   oesp-fanctl mode auto
FAN_MODE=auto
TEMP_ON=38              # CPU 高于此温度开风扇（℃）
TEMP_OFF=35             # CPU 低于此温度关风扇（℃）
HDD_ON_TEMP=50          # 任一硬盘达到此温度启动定时通风（℃）
HDD_RUN_SECONDS=60      # 硬盘触发后风扇运行时长（秒），到时自动关闭
HDD_COOLDOWN=60         # 通风结束后强制停机间歇（秒），间歇结束若仍超温再开新一轮
EMERGENCY_TEMP=70       # CPU 超过此温度强制开启风扇（℃）
DISK_EMERGENCY_TEMP=55  # 任一硬盘超过此温度强制开启风扇（℃，纯兜底保护）
INTERVAL=2              # 检测周期（秒）
STABLE_COUNT=3          # 连续 N 次超温才启动风扇
MIN_RUN=60              # CPU 温控风扇最短运行时间（秒）
DISK_CHECK_CYCLES=10    # 每 N 个周期读一次硬盘温度（仅用于显示/曲线）
