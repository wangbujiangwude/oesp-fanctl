#!/bin/bash
# ============================================================
#  oesp-fanctl - OESP(OES Plus / Amlogic S922X) 飞牛 fnOS 温控风扇控制
# ============================================================
#  硬件事实（2026-10-15 实测结论）：
#   · 内置 CPU 风扇为 GPIO 二态开关风扇，只有「开 / 关」，不支持转速调节
#   · 风扇引脚 = gpiochip0 line 45（= 全局 GPIO 557，DTB: gpio-fan gpios 第二字段 0x2d）
#   · fnOS 1.2.0701 起厂商 DTB 把该引脚由 line 46 改为 line 45 → 写死引脚的老脚本失效
#
#  控制通路（本版核心改动）：
#   ★ 首选 gpio 直控：先 modprobe -r gpio_fan 卸掉内核风扇驱动，
#     再用 gpioset -m signal 常驻持有 line 45 直接拉高/拉低。
#     原因：gpio-fan.ko 加载后会把自己注册成 thermal cooling_device，
#     内核 step_wise 调控器在 <60℃ 时会强行把风扇关掉，导致写 hwmon
#     fan1_target 的值约 1 秒后被内核覆盖 —— 这条路在本机不可用。
#   ☆ 回退 hwmon：若系统无 gpioset/gpiod，则退回写 fan1_target
#     （仅在该机型无 gpio 直控能力时使用，可靠性受内核调控器影响）。
#
#  策略特性：
#   · 运行模式 FAN_MODE（2026-10-16 新增）：
#       auto = 自动温控（默认，按 CPU / 硬盘温度启停）
#       on   = 常开：风扇一直运行，完全忽略温度判定（适合夏季高温 / 硬盘密集 / 求稳）
#       off  = 常关：风扇一直停止，完全忽略温度判定（适合夜间静音）
#     运行时可切换，守护进程 2 秒内生效：oesp-fanctl set mode on
#     ⚠ 注意：on / off 为强制覆盖模式，会同时忽略「过热紧急保护」。
#        off 模式下即使 CPU 超过 EMERGENCY_TEMP 也不会开风扇，请留意散热风险。
#   · CPU 迟滞温控：>=TEMP_ON 开，<=TEMP_OFF 关
#   · 探针抗噪（2026-10-27 新增）：CPU 温度先做有效性校验（读取失败/0/超量程不参与判定），
#     再做 TEMP_FILTER 点中位数滤波 —— 本机 thermal_zone0 单点读数会在 34~39℃ 间跳 4℃，
#     单点判定会造成「看着没到阈值却停风扇」。
#   · 双向持续时间防抖（2026-10-27 新增）：
#     温度持续 >=TEMP_ON 达 ON_DELAY 秒才开，持续 <=TEMP_OFF 达 OFF_DELAY 秒才关；
#     配合 MIN_RUN 最短运行时间，彻底避免阈值附近频繁启停。
#   · 硬盘监控可关（2026-10-27 新增）：HDD_MONITOR=auto|on|off
#       auto = 仅在硬盘已唤醒时读温度（用 hdparm -C 探测，standby 就跳过，不影响休眠）
#       on   = 始终读取（会持续唤醒硬盘）
#       off  = 完全不读硬盘温度（硬盘可正常休眠，硬盘通风与硬盘兜底随之停用）
#   · 硬盘定时通风：任一盘 >=HDD_ON_TEMP 开，运行 HDD_RUN_SECONDS 后停机 HDD_COOLDOWN 秒，
#     间歇结束仍超温则开新一轮，降温则保持关
#   · 过热紧急保护：CPU / 硬盘过高强制开启（兜底）
#   · 安装即用：启动自动接管/停掉系统自带风扇控制服务（fanctl / pwm-fancontrol / fan-fullspeed）
#   · 运行时可改配置（编辑配置文件即 2 秒内生效）
#
#  用法：
#   oesp-fanctl daemon          守护模式（systemd 用）
#   oesp-fanctl status          查看当前温度/风扇/阈值/后端
#   oesp-fanctl set on 38       设置 CPU 开启温度
#   oesp-fanctl set off 35      设置 CPU 关闭温度
#   oesp-fanctl set hdd 50      设置硬盘定时通风开启温度
#   oesp-fanctl set delay 5     设置开/关防抖秒数（高温/低温需持续多久才动作）
#   oesp-fanctl set hddmon off  硬盘温度监控：auto=仅唤醒时读 / on=始终读 / off=不读
#   oesp-fanctl set mode on     设置运行模式（auto=自动温控 / on=常开 / off=常关）
#   oesp-fanctl mode on         同上，简写
#   oesp-fanctl test on|off     手动开/关风扇测试（一次性，会短暂抢占控制权）
#   oesp-fanctl restore         释放 GPIO 并恢复系统自带风扇控制（卸载/停用前调用）
#   oesp-fanctl log             查看运行日志
# ============================================================

CONF=${OESP_FANCTL_CONF:-/etc/oesp-fanctl.conf}
LOG=${OESP_FANCTL_LOG:-/var/log/oesp-fanctl.log}
STATE_FILE=${OESP_FANCTL_STATE:-/run/oesp-fanctl.state}
HISTORY_FILE=${OESP_FANCTL_HISTORY:-/var/log/oesp-fanctl-history.csv}
WEB_PORT=${WEB_PORT:-8765}
WEB_SOCK=""             # Web 监控页网关 socket（由 resolve_paths 自动发现，用于 status 显示）

# ---------- 默认配置（配置文件不存在时用；OESP 机型默认值） ----------
FAN_MODE=auto           # 运行模式：auto=自动温控 / on=常开（一直运行） / off=常关（一直停）
TEMP_ON=38              # CPU 高于此温度开风扇（℃）—— 沿用用户原 fanctl.sh 设置
TEMP_OFF=35             # CPU 低于此温度关风扇（℃）—— 沿用用户原 fanctl.sh 设置
HDD_ON_TEMP=50          # 任一硬盘达到此温度启动定时通风（℃）
HDD_RUN_SECONDS=60      # 硬盘触发后风扇运行时长（秒），到时自动关闭
HDD_COOLDOWN=60         # 通风结束后强制停机间歇（秒）；间歇结束若仍超温则再开新一轮
EMERGENCY_TEMP=70       # CPU 超过此温度强制开启风扇（℃）
DISK_EMERGENCY_TEMP=55  # 任一硬盘超过此温度强制开启风扇（℃，纯兜底）
INTERVAL=2              # 检测周期（秒）
ON_DELAY=5              # 温度持续高于 TEMP_ON 达 N 秒才开风扇（防抖，0=立即）
OFF_DELAY=5             # 温度持续低于 TEMP_OFF 达 N 秒才关风扇（防抖，0=立即）
TEMP_FILTER=3           # CPU 温度中位数滤波窗口（1=不滤波；3/5 可抑制探针毛刺）
MIN_RUN=60              # CPU 温控风扇最短运行时间（秒）
DISK_CHECK_CYCLES=10    # 每 N 个周期读一次硬盘温度（smartctl 开销大）
HDD_MONITOR=auto        # 硬盘温度监控：auto=仅在硬盘已唤醒时读（不影响休眠）/ on=始终读 / off=完全不读
STABLE_COUNT=3          # 【已废弃】旧版防抖计数，保留仅为兼容旧配置，现由 ON_DELAY 取代

load_conf() {
    resolve_paths
    [ -f "$CONF" ] && . "$CONF"
}

# ---------- 路径自动发现 ----------
# 由应用中心启动时，环境变量 OESP_FANCTL_CONF/STATE/LOG/HISTORY 已由 appcenter 注入；
# 但用户直接在 SSH 里执行 oesp-fanctl（status / set / mode / log）时并没有这些变量，
# 会回落到 /etc/oesp-fanctl.conf 等不存在的默认路径 → 命令报「配置文件不存在」。
# 这里按实际安装位置自动补齐（仅在对应环境变量未设置时生效，不影响守护进程）。
resolve_paths() {
    local c
    if [ -z "${OESP_FANCTL_CONF:-}" ]; then
        for c in /vol1/@appconf/oesp-fanctl/oesp-fanctl.conf /etc/oesp-fanctl.conf; do
            [ -f "$c" ] && { CONF=$c; break; }
        done
    fi
    if [ -z "${OESP_FANCTL_STATE:-}" ]; then
        for c in /vol1/@appdata/oesp-fanctl/oesp-fanctl.state \
                 /var/apps/oesp-fanctl/var/oesp-fanctl.state /run/oesp-fanctl.state; do
            [ -f "$c" ] && { STATE_FILE=$c; break; }
        done
    fi
    if [ -z "${OESP_FANCTL_LOG:-}" ]; then
        for c in /vol1/@appdata/oesp-fanctl/oesp-fanctl.log \
                 /var/apps/oesp-fanctl/var/oesp-fanctl.log; do
            [ -f "$c" ] && { LOG=$c; break; }
        done
    fi
    if [ -z "${OESP_FANCTL_HISTORY:-}" ]; then
        for c in /vol1/@appdata/oesp-fanctl/history.csv \
                 /var/apps/oesp-fanctl/var/history.csv; do
            [ -f "$c" ] && { HISTORY_FILE=$c; break; }
        done
    fi
    # Web 监控页的网关 socket（用于 status 里显示正确的访问方式）
    if [ -z "${OESP_FANCTL_SOCK:-}" ]; then
        for c in /vol1/@appcenter/oesp-fanctl/target/app.sock \
                 /var/apps/oesp-fanctl/target/target/app.sock; do
            [ -S "$c" ] && { WEB_SOCK=$c; break; }
        done
    else
        WEB_SOCK="$OESP_FANCTL_SOCK"
    fi
}

# 归一化运行模式 → 只输出 auto / on / off
normalize_mode() {
    case "${1:-auto}" in
        auto|AUTO|Auto|"")                                              echo auto ;;
        on|ON|On|always|always_on|always-on|force_on|force-on|open|1|yes|true)
                                                                       echo on ;;
        off|OFF|Off|always_off|always-off|force_off|force-off|close|stop|0|no|false)
                                                                       echo off ;;
        *)                                                              echo auto ;;
    esac
}

# ============================================================
#  GPIO 直控后端（OESP 首选）
# ============================================================
GPIO_CHIP="gpiochip0"
GPIO_LINE=""            # 运行时探测
GPIO_PID=""             # 常驻持有的 gpioset 进程
GPIO_CUR=""             # 当前持有的电平：0=关 1=开
FAN_BACKEND=""          # "gpio" | "hwmon"
FAN_NODE=""             # hwmon 回退时的 fan1_target 路径

# 从设备树读取风扇 GPIO offset（硬件权威描述），失败兜底 45
dt_gpio_line() {
    local dt=/sys/firmware/devicetree/base/gpio-fan/gpios off
    if [ -r "$dt" ]; then
        # gpios = <phandle offset flags>，大端 3 个 u32；取第 2 个
        off=$(od -An -tu4 --endian=big "$dt" 2>/dev/null | awk '{print $2}')
        case "$off" in
            ''|*[!0-9]*) : ;;
            *) [ "$off" -lt 200 ] && { echo "$off"; return 0; } ;;
        esac
    fi
    echo 45
}

gpio_fan_loaded() { lsmod 2>/dev/null | grep -q '^gpio_fan'; }

# 卸载 gpio_fan 内核驱动，释放引脚给用户态 gpioset
release_gpio_fan() {
    gpio_fan_loaded || return 0
    modprobe -r gpio_fan 2>/dev/null && return 0
    return 1
}

# 重新加载 gpio_fan，恢复厂商 60℃ 内核温控（卸载/停用本应用时调用）
restore_gpio_fan() {
    gpio_fan_loaded && return 0
    modprobe gpio_fan 2>/dev/null
}

# ============================================================
#  后端探测
# ============================================================
detect_backend() {
    FAN_BACKEND=""; FAN_NODE=""
    # 1) gpio 直控（首选）
    if command -v gpioset >/dev/null 2>&1 && [ -e "/dev/$GPIO_CHIP" ]; then
        GPIO_LINE=$(dt_gpio_line)
        FAN_BACKEND="gpio"
        return 0
    fi
    # 2) hwmon 回退（写 fan1_target）
    local f
    for f in /sys/devices/platform/gpio-fan/hwmon/hwmon*/fan1_target; do
        [ -w "$f" ] && { FAN_NODE="$f"; FAN_BACKEND="hwmon"; return 0; }
    done
    for f in /sys/class/hwmon/hwmon*/fan1_target; do
        [ -w "$f" ] && grep -q "gpio" "$(dirname "$f")/name" 2>/dev/null \
            && { FAN_NODE="$f"; FAN_BACKEND="hwmon"; return 0; }
    done
    return 1
}

# 统一写风扇：set_fan <0|1>
set_fan() {
    local val=$1
    case "$FAN_BACKEND" in
        gpio)
            # 常驻持有引脚；仅当状态变化或进程已死时才重启 gpioset
            if [ "$val" = "$GPIO_CUR" ] && [ -n "$GPIO_PID" ] && kill -0 "$GPIO_PID" 2>/dev/null; then
                return 0
            fi
            [ -n "$GPIO_PID" ] && kill "$GPIO_PID" 2>/dev/null
            gpioset -m signal "$GPIO_CHIP" "$GPIO_LINE=$val" >/dev/null 2>&1 &
            GPIO_PID=$!
            GPIO_CUR=$val
            sleep 0.1
            ;;
        hwmon)
            [ -n "$FAN_NODE" ] && echo "$val" > "$FAN_NODE" 2>/dev/null
            ;;
    esac
}

read_fan() {
    case "$FAN_BACKEND" in
        gpio)
            # 守护进程内：直接用运行时变量
            if [ -n "${GPIO_CUR:-}" ]; then echo "$GPIO_CUR"; return; fi
            # 独立进程（如 oesp-fanctl status）：变量为空，
            # 从 state 文件读守护进程上报的实际状态（引脚被 gpioset 持有，gpioget 会 EBUSY）
            local v="" sf
            resolve_paths
            for sf in "$STATE_FILE" /vol1/@appdata/oesp-fanctl/oesp-fanctl.state \
                      /var/apps/oesp-fanctl/var/oesp-fanctl.state /run/oesp-fanctl.state; do
                [ -f "$sf" ] || continue
                v=$(grep -o 'fan_state=[0-9]*' "$sf" 2>/dev/null | head -1 | cut -d= -f2)
                [ -n "$v" ] && break
            done
            [ -z "$v" ] && v=$(gpioget "$GPIO_CHIP" "$GPIO_LINE" 2>/dev/null | tr -dc '0-9' | head -c1)
            echo "${v:-?}"
            ;;
        hwmon) cat "$FAN_NODE" 2>/dev/null || echo "?" ;;
        *)     echo "?" ;;
    esac
}

# 停掉与风扇抢控制权的系统服务（安装即用：自动接管）
takeover_services() {
    local svc
    for svc in fanctl.service pwm-fancontrol.service fan-fullspeed.service; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            systemctl stop "$svc" 2>/dev/null && log "已停止冲突服务 $svc"
        fi
        systemctl disable "$svc" 2>/dev/null
    done
    # 杀掉非 systemd 托管的裸脚本（用户旧版 fanctl.sh 等）
    pkill -f 'fanctl\.sh' 2>/dev/null
}

get_temp_milli() {  # 原始毫摄氏度整数（不做任何截断，专用于精确比较）
    cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0
}

# ---------- CPU 温度：有效性校验 + 中位数滤波 ----------
# 背景（2026-10-27 在 OESP 实测）：thermal_zone0 连续 10 次读数落在 34.4~38.6℃，
# 单点波动可达 4℃，直接拿单点值判定，就会出现「看着没到阈值却把风扇停了」的现象。
# 对策三层：
#   ① 读数无效（读取失败 / 0 / 超量程）时绝不参与判定，沿用上次有效值；
#   ② 用最近 N 个采样的「中位数」作为判定值，抑制单点毛刺（TEMP_FILTER）；
#   ③ 状态切换再由 ON_DELAY / OFF_DELAY 做持续时间确认。
TEMP_HIST=()
TEMP_LAST_VALID=0

read_cpu_raw() {   # 成功输出毫摄氏度；失败返回非 0
    local raw
    raw=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
    case "$raw" in
        ''|*[!0-9]*) return 1 ;;
    esac
    # 0 或 >150℃ 视为读取异常：绝不能拿它去判定，否则会误关风扇
    [ "$raw" -gt 0 ] && [ "$raw" -lt 150000 ] || return 1
    echo "$raw"
}

push_temp() {      # $1 = 有效毫摄氏度
    local lim=${TEMP_FILTER:-3}
    case "$lim" in ''|*[!0-9]*) lim=3 ;; esac
    [ "$lim" -lt 1 ] && lim=1
    TEMP_HIST+=("$1")
    while [ "${#TEMP_HIST[@]}" -gt "$lim" ]; do
        TEMP_HIST=("${TEMP_HIST[@]:1}")
    done
    TEMP_LAST_VALID=$1
}

filtered_temp() {  # 输出中位数（无数据时用上次有效值）
    local n=${#TEMP_HIST[@]}
    if [ "$n" -eq 0 ]; then echo "${TEMP_LAST_VALID:-0}"; return; fi
    if [ "$n" -eq 1 ]; then echo "${TEMP_HIST[0]}"; return; fi
    printf '%s\n' "${TEMP_HIST[@]}" | sort -n | sed -n "$(( (n + 1) / 2 ))p"
}

fmt_temp() {       # 毫摄氏度 → 一位小数
    local t=${1:-0}
    printf '%d.%d' $(( t / 1000 )) $(( (t % 1000) / 100 ))
}

get_temp() {  # 一位小数温度（℃），仅用于显示/记录
    local t
    t=$(get_temp_milli)
    printf '%d.%d' $(( t / 1000 )) $(( (t % 1000) / 100 ))
}

# ---------- 第二路温度探测（GPU / DDR）----------
# 注意：OESP（Amlogic S922X）没有独立 GPU 热区，thermal_zone1 的 type 是
# "ddr-thermal"（内存温度），旧版无脑把它当 GPU 显示是错的，这里按实际 type 标注。
GPU_NODE=""
GPU_LABEL=""
detect_gpu() {
    GPU_NODE=""; GPU_LABEL=""
    local z tp
    for z in /sys/class/thermal/thermal_zone*; do
        tp=$(cat "$z/type" 2>/dev/null)
        case "$tp" in
            *gpu*|*GPU*)
                [ -f "$z/temp" ] && { GPU_NODE="$z/temp"; GPU_LABEL="GPU"; return; } ;;
        esac
    done
    # 回退：取 zone1，并按它的真实 type 命名（本机为 ddr-thermal → DDR）
    if [ -f /sys/class/thermal/thermal_zone1/temp ]; then
        GPU_NODE=/sys/class/thermal/thermal_zone1/temp
        tp=$(cat /sys/class/thermal/thermal_zone1/type 2>/dev/null)
        case "$tp" in
            *ddr*|*DDR*) GPU_LABEL="DDR" ;;
            *soc*|*SOC*) GPU_LABEL="SOC" ;;
            *)           GPU_LABEL="SOC" ;;
        esac
    fi
}

get_gpu_temp() {
    [ -z "$GPU_NODE" ] && { echo 0; return; }
    local t
    t=$(cat "$GPU_NODE" 2>/dev/null || echo 0)
    printf '%d.%d' $(( t / 1000 )) $(( (t % 1000) / 100 ))
}

# ---------- 硬盘温度探测 ----------
DISK_SOURCES=()
DISK_LABELS=()
detect_disks() {
    DISK_SOURCES=(); DISK_LABELS=()
    local h d lbl b
    for h in /sys/class/hwmon/hwmon*; do
        if [ "$(cat "$h/name" 2>/dev/null)" = "drivetemp" ] && [ -f "$h/temp1_input" ]; then
            lbl=""
            for b in "$h/device"/block/*; do [ -e "$b" ] && lbl=$(basename "$b"); done
            [ -z "$lbl" ] && lbl=$(basename "$(readlink -f "$h/device" 2>/dev/null)" 2>/dev/null)
            [ -z "$lbl" ] && lbl="disk${#DISK_SOURCES[@]}"
            DISK_SOURCES+=("$h/temp1_input"); DISK_LABELS+=("$lbl")
        fi
    done
    if [ ${#DISK_SOURCES[@]} -eq 0 ] && command -v smartctl >/dev/null 2>&1; then
        for d in /dev/sd? /dev/nvme?; do
            [ -b "$d" ] && { DISK_SOURCES+=("smart:$d"); DISK_LABELS+=("$(basename "$d")"); }
        done
    fi
}

DISK_TEMPS_OUT=""
DISK_MAX_TEMP=0
DISK_READ_STATE="ok"    # ok / asleep（有盘在休眠被跳过）/ off（监控已关闭）

# 硬盘是否处于休眠（standby / sleep）。
# hdparm -C 发的是 CHECK POWER MODE，不会把盘唤醒，可安全用作前置探测。
disk_asleep() {
    local dev="/dev/$1" st
    [ -b "$dev" ] || return 1
    command -v hdparm >/dev/null 2>&1 || return 1
    st=$(hdparm -C "$dev" 2>/dev/null | grep -oE 'standby|sleep|active/idle|idle|unknown')
    case "$st" in standby|sleep) return 0 ;; *) return 1 ;; esac
}

normalize_hddmon() {
    case "${1:-auto}" in
        off|OFF|Off|0|no|false|disable|disabled)  echo off ;;
        on|ON|On|1|yes|true|always|force)         echo on ;;
        *)                                        echo auto ;;
    esac
}

read_disk_temps() {
    DISK_TEMPS_OUT=""; DISK_MAX_TEMP=0; DISK_READ_STATE="ok"
    local mode skipped=0 i s t ti lbl
    mode=$(normalize_hddmon "${HDD_MONITOR:-auto}")

    # off：完全不接触硬盘（不读 hwmon、不发 SMART），硬盘可正常进入休眠
    if [ "$mode" = "off" ]; then
        DISK_READ_STATE="off"
        return 0
    fi

    for i in "${!DISK_SOURCES[@]}"; do
        s="${DISK_SOURCES[$i]}"; lbl="${DISK_LABELS[$i]}"; t=0
        # auto：盘已休眠则跳过本次读取，避免读取动作把它唤醒（不影响休眠的关键）
        if [ "$mode" = "auto" ] && disk_asleep "$lbl"; then
            skipped=$((skipped + 1))
            continue
        fi
        case "$s" in
            smart:*)
                ti=$(smartctl -n standby -A "${s#smart:}" 2>/dev/null \
                    | awk '/Temperature_Celsius/{print $10; exit} /^Temperature:/{print $2; exit}')
                [ -n "$ti" ] && t="${ti}.0" ;;
            *)
                ti=$(cat "$s" 2>/dev/null || echo 0)
                t=$(printf '%d.%d' $(( ti / 1000 )) $(( (ti % 1000) / 100 ))) ;;
        esac
        [ -z "$t" ] && t=0
        DISK_TEMPS_OUT="${DISK_TEMPS_OUT}${lbl}=$t
"
        [ "${t%.*}" -gt "$DISK_MAX_TEMP" ] 2>/dev/null && DISK_MAX_TEMP=${t%.*}
    done
    [ "$skipped" -gt 0 ] && DISK_READ_STATE="asleep"
    return 0
}

log() {
    local line="[$(date '+%F %T')] $1"
    echo "$line" >> "$LOG"
    if [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
        tail -n 500 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
    fi
}

# ---------- 守护主循环 ----------
WEB_PID=""
cleanup() {
    [ -n "$WEB_PID" ] && kill "$WEB_PID" 2>/dev/null
    # 释放 GPIO：结束常驻 gpioset 进程（引脚归还硬件默认状态）
    if [ "$FAN_BACKEND" = "gpio" ] && [ -n "$GPIO_PID" ]; then
        kill "$GPIO_PID" 2>/dev/null
        GPIO_PID=""
    fi
    log "守护进程退出"
    exit 0
}

cmd_daemon() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "需要 root 权限运行"; exec sudo "$0" daemon
    fi
    mkdir -p "$(dirname "$LOG")" "$(dirname "$STATE_FILE")" "$(dirname "$HISTORY_FILE")" 2>/dev/null
    load_conf

    if ! detect_backend; then
        echo "错误：找不到风扇控制通路（gpioset 与 fan1_target 均不可用）"
        echo "请确认 dtb 为 OES Plus 适配版本（含 gpio-fan 节点），或安装 gpiod：apt install gpiod"
        exit 1
    fi

    # 接管系统服务（安装即用：不与任何既有风扇控制打架）
    takeover_services

    if [ "$FAN_BACKEND" = "gpio" ]; then
        if release_gpio_fan; then
            log "已卸载 gpio_fan 驱动，改用 gpio 直控（$GPIO_CHIP line $GPIO_LINE）"
        else
            log "警告：gpio_fan 驱动卸载失败，尝试直接用 gpioset 抢占引脚"
        fi
        log "启动 oesp-fanctl，后端=gpio（$GPIO_CHIP line $GPIO_LINE，0=关 1=开）"
    else
        log "启动 oesp-fanctl，后端=hwmon（$FAN_NODE）"
        log "提示：gpio-fan 内核调控器可能在 <60℃ 时覆盖本工具写入，建议安装 gpiod 以启用 gpio 直控"
    fi

    detect_gpu
    [ -n "$GPU_NODE" ] && log "${GPU_LABEL:-SOC} 温度节点: $GPU_NODE"

    # --- 启动 Web 监控页 ---
    start_web() {
        command -v python3 >/dev/null 2>&1 || { log "无 python3，Web 监控页不可用（风扇控制不受影响）"; return; }
        local sd ws="" c
        sd=$(dirname "$(readlink -f "$0")" 2>/dev/null)
        for c in "${OESP_FANCTL_WEBSCRIPT:-}" "$sd/fanweb.py" /usr/local/bin/fanweb.py "${TRIM_APPDEST:-/nonexistent}/fanweb.py"; do
            [ -n "$c" ] && [ -f "$c" ] && { ws="$c"; break; }
        done
        [ -z "$ws" ] && { log "未找到 fanweb.py，Web 监控页不可用"; return; }
        OESP_FANCTL_CONF="$CONF" OESP_FANCTL_STATE="$STATE_FILE" OESP_FANCTL_HISTORY="$HISTORY_FILE" \
        WEB_PORT="$WEB_PORT" nohup python3 "$ws" >> "$LOG" 2>&1 &
        WEB_PID=$!
        if [ -n "${OESP_FANCTL_SOCK:-}" ]; then
            log "Web 监控页已启动: 飞牛桌面「OESP风扇助手」图标（网关 ${OESP_FANCTL_BASE:-/app/oesp-fanctl}，unix socket，pid $WEB_PID）"
        else
            log "Web 监控页已启动: http://0.0.0.0:${WEB_PORT} (pid $WEB_PID)"
        fi
    }
    trap cleanup EXIT TERM INT
    # 单例保护：清掉上一次残留的 fanweb 实例，避免重复监听同一个 socket
    pkill -f 'fanweb\.py' 2>/dev/null
    sleep 0.3
    start_web

    # --- 状态变量 ---
    local cpu_fan=0
    local cpu_fan_start=0
    local hot_since=0          # 温度连续高于 TEMP_ON 的起始时刻（0=未在高温）
    local cold_since=0         # 温度连续低于 TEMP_OFF 的起始时刻（0=未在低温）
    local TEMP_READ_FAIL=0     # 温度读取异常告警去重
    local emergency=0
    local hdd_run_until=0
    local hdd_cool_until=0
    local fan_state=0
    local cycle=0
    local dmax=0
    local cur_mode=""        # 已生效的运行模式（用于模式切换时只打一次日志）
    local cur_hmon=""        # 已生效的硬盘监控方式（变更时立即重读，不等节流周期）

    detect_disks
    case "$(normalize_hddmon "${HDD_MONITOR:-auto}")" in
        off) log "硬盘温度监控已关闭（HDD_MONITOR=off）：完全不读硬盘，硬盘可正常休眠；仅按 CPU 温度控制" ;;
        on)  log "硬盘温度监控：始终读取（HDD_MONITOR=on，会持续访问硬盘，可能影响休眠）" ;;
        *)   log "硬盘温度监控：仅唤醒时读取（HDD_MONITOR=auto，硬盘休眠时自动跳过，不影响休眠）" ;;
    esac
    if [ "${#DISK_SOURCES[@]}" -gt 0 ]; then
        log "硬盘温度源 ${#DISK_SOURCES[@]} 个: ${DISK_SOURCES[*]}"
    elif [ "$(normalize_hddmon "${HDD_MONITOR:-auto}")" != "off" ]; then
        log "未找到硬盘温度源（可执行 modprobe drivetemp 后重启本服务），仅按 CPU 温度控制"
    fi

    # 初始状态：常开模式立即开启（避免启动瞬间的关→开抖动），否则先关由主循环决策
    if [ "$(normalize_mode "${FAN_MODE:-auto}")" = "on" ]; then
        set_fan 1
        fan_state=1
        cur_mode=on
        log "启动：运行模式为「常开」，风扇立即运行"
    else
        set_fan 0
    fi

    while true; do
        load_conf
        local now=$(date +%s)
        # --- 取温度：先做有效性校验，再进滤波窗口，用中位数做判定 ---
        local raw_tm inst_f tm
        if raw_tm=$(read_cpu_raw); then
            push_temp "$raw_tm"
            inst_f=$(fmt_temp "$raw_tm")
            TEMP_READ_FAIL=0
        else
            # 读取失败 / 0 / 超量程：不进入滤波窗口，也不改变判定依据，沿用上次有效值。
            # 旧版这里直接用 0 参与比较，会瞬间判定「<= TEMP_OFF」而误关风扇。
            inst_f="?"
            if [ "$TEMP_READ_FAIL" -eq 0 ]; then
                log "警告：CPU 温度读取异常，暂用上次有效值 $(fmt_temp "$TEMP_LAST_VALID")℃ 继续控制"
                TEMP_READ_FAIL=1
            fi
        fi
        tm=$(filtered_temp)
        # 冷启动尚未拿到任何有效读数：跳过本轮，绝不能让 0℃ 触发关风扇
        if [ "$tm" -le 0 ]; then
            sleep "$INTERVAL"; continue
        fi
        local temp_f=$(fmt_temp "$tm")
        cycle=$((cycle + 1))

        # 硬盘温度：off 必须当拍就清空（否则关掉监控后 Web 还会残留最多
        # DISK_CHECK_CYCLES 个周期的旧读数，看起来像没关掉）；监控方式一变也当拍重读，
        # 免得用户从 off 切回 auto 后要干等一个完整节流周期（约 20 秒）才有温度。
        local hmon=$(normalize_hddmon "${HDD_MONITOR:-auto}")
        local hmon_changed=0
        [ "$hmon" != "$cur_hmon" ] && hmon_changed=1
        if [ "$hmon" = "off" ]; then
            DISK_TEMPS_OUT=""; DISK_MAX_TEMP=0; DISK_READ_STATE="off"
        elif [ "${#DISK_SOURCES[@]}" -gt 0 ]; then
            if [ "$hmon_changed" -eq 1 ] || [ $(( cycle % DISK_CHECK_CYCLES )) -eq 1 ] || [ "$cycle" -eq 1 ]; then
                read_disk_temps
            fi
            [ $(( cycle % 150 )) -eq 0 ] && detect_disks
        else
            DISK_TEMPS_OUT=""; DISK_MAX_TEMP=0
        fi
        cur_hmon=$hmon
        dmax=$DISK_MAX_TEMP
        local gpu_f=$(get_gpu_temp)

        # --- 运行模式（auto=自动温控 / on=常开 / off=常关）---
        local fan_mode=$(normalize_mode "${FAN_MODE:-auto}")
        local just_switch=0
        if [ "$fan_mode" != "$cur_mode" ]; then
            case "$fan_mode" in
                on)  log "运行模式 → 常开：风扇持续运行，忽略温度判定" ;;
                off) log "运行模式 → 常关：风扇持续停止，忽略温度判定" ;;
                *)   log "运行模式 → 自动温控：按 CPU / 硬盘温度启停" ;;
            esac
            [ -n "$cur_mode" ] && just_switch=1   # 首次启动不算"切换"
            cur_mode=$fan_mode
        fi
        # -1 = 不覆盖（自动温控）；0 = 强制关；1 = 强制开
        local mode_override=-1
        [ "$fan_mode" = "on" ]  && mode_override=1
        [ "$fan_mode" = "off" ] && mode_override=0

        if [ "$mode_override" -ge 0 ]; then
            # 常开 / 常关：完全跳过温度判定，并清零内部计数，
            # 避免切回 auto 时残留的防抖计时器造成误动作
            cpu_fan=0; cpu_fan_start=0; emergency=0
            hot_since=0; cold_since=0
            local hdd_want_on=0
            hdd_run_until=0; hdd_cool_until=0
        else

        # --- CPU 温控（中位数滤波 + 双向持续时间防抖 + 最短运行）---
        # 开：温度持续 >= TEMP_ON 达 ON_DELAY 秒
        # 关：温度持续 <= TEMP_OFF 达 OFF_DELAY 秒（且已运行 >= MIN_RUN 秒）
        # 中间区间（TEMP_OFF ~ TEMP_ON）为死区，保持当前状态不动，计时器清零。
        local cpu_hot=0 cpu_cold=0
        [ "$tm" -ge $(( TEMP_ON  * 1000 )) ] && cpu_hot=1
        [ "$tm" -le $(( TEMP_OFF * 1000 )) ] && cpu_cold=1
        if [ "$cpu_hot" -eq 1 ]; then
            cold_since=0
            if [ "$hot_since" -eq 0 ]; then
                # 刚从常开/常关切回自动：视为「条件早已持续满足」，立即判定，
                # 否则用户手动切回自动后还要干等 ON_DELAY 秒，体验很怪。
                if [ "$just_switch" -eq 1 ]; then hot_since=$(( now - ${ON_DELAY:-0} ))
                else hot_since=$now; fi
            fi
            if [ "$cpu_fan" -eq 0 ] && [ $(( now - hot_since )) -ge "${ON_DELAY:-0}" ]; then
                cpu_fan=1; cpu_fan_start=$now
                log "CPU ${temp_f}℃（瞬时 ${inst_f}）>= ${TEMP_ON}℃ 已持续 $(( now - hot_since ))s，风扇启动（CPU 温控）"
            fi
        elif [ "$cpu_cold" -eq 1 ]; then
            hot_since=0
            if [ "$cold_since" -eq 0 ]; then
                if [ "$just_switch" -eq 1 ]; then cold_since=$(( now - ${OFF_DELAY:-0} ))
                else cold_since=$now; fi
            fi
            if [ "$cpu_fan" -eq 1 ] && [ $(( now - cold_since )) -ge "${OFF_DELAY:-0}" ]; then
                local run_secs=$(( now - cpu_fan_start ))
                if [ "$run_secs" -ge "${MIN_RUN:-0}" ]; then
                    cpu_fan=0; cpu_fan_start=0
                    log "CPU ${temp_f}℃（瞬时 ${inst_f}）<= ${TEMP_OFF}℃ 已持续 $(( now - cold_since ))s，风扇停止（已运行 ${run_secs}s）"
                fi
            fi
        else
            # 死区：保持现状，避免在阈值附近来回抖
            hot_since=0; cold_since=0
        fi

        # --- 过热紧急保护（带 5℃ 迟滞）---
        local cpu_emerg=0 disk_emerg=0
        if [ "$emergency" -eq 1 ]; then
            [ "$tm" -ge $(( (EMERGENCY_TEMP - 5) * 1000 )) ] && cpu_emerg=1
            [ "$dmax" -gt 0 ] && [ "$dmax" -ge $((DISK_EMERGENCY_TEMP - 5)) ] && disk_emerg=1
        else
            [ "$tm" -ge $(( EMERGENCY_TEMP * 1000 )) ] && cpu_emerg=1
            [ "$dmax" -gt 0 ] && [ "$dmax" -ge "$DISK_EMERGENCY_TEMP" ] && disk_emerg=1
        fi
        if [ "$cpu_emerg" -eq 1 ] || [ "$disk_emerg" -eq 1 ]; then
            if [ "$emergency" -eq 0 ]; then
                log "!! 过热 CPU ${temp_f}℃ / 硬盘 ${dmax}℃，强制开启风扇"
            fi
            emergency=1
            # 同时把 CPU 温控路径置位：否则紧急保护退出（迟滞 5℃）的瞬间，
            # 若 cpu_fan 还是 0，want_on 会掉回 0 而让风扇闪停一个周期。
            cpu_fan=1; cpu_fan_start=${cpu_fan_start:-$now}
            [ "$hot_since" -eq 0 ] && hot_since=$now
        else
            emergency=0
        fi

        # --- 硬盘定时通风（间歇式）---
        local hdd_want_on=0
        if [ "$now" -lt "$hdd_run_until" ]; then
            hdd_want_on=1
        elif [ "$now" -lt "$hdd_cool_until" ]; then
            hdd_want_on=0
        elif [ "$dmax" -gt 0 ] && [ "$dmax" -ge "$HDD_ON_TEMP" ]; then
            hdd_run_until=$(( now + HDD_RUN_SECONDS ))
            hdd_cool_until=$(( hdd_run_until + HDD_COOLDOWN ))
            hdd_want_on=1
            log "硬盘 ${dmax}℃ 仍 >= ${HDD_ON_TEMP}℃，新一轮定时通风（运行 ${HDD_RUN_SECONDS}s，停机间歇 ${HDD_COOLDOWN}s）"
        else
            hdd_want_on=0
        fi

        fi  # 结束「自动温控」分支

        # --- 综合判定（二态）：常开/常关直接覆盖；否则任一来源要求开即开 ---
        local want_on=0
        if [ "$mode_override" -ge 0 ]; then
            want_on=$mode_override
        else
            [ "$cpu_fan" -eq 1 ] && want_on=1
            [ "$hdd_want_on" -eq 1 ] && want_on=1
            [ "$emergency" -eq 1 ] && want_on=1
        fi
        if [ "$want_on" -ne "$fan_state" ]; then
            fan_state=$want_on
            if [ "$mode_override" -ge 0 ]; then
                [ "$fan_state" -eq 1 ] && log "风扇 → 开启（常开模式）" || log "风扇 → 关闭（常关模式）"
            elif [ "$fan_state" -eq 1 ]; then
                log "风扇 → 开启（CPU温控=${cpu_fan} 硬盘通风=${hdd_want_on} 紧急=${emergency}）"
            else
                log "风扇 → 关闭"
            fi
        fi

        set_fan "$fan_state"

        # --- 状态文件（Web 页读取）---
        {
            echo "temp=$temp_f"
            echo "temp_inst=$inst_f"
            echo "gpu=$gpu_f"
            echo "gpu_label=${GPU_LABEL:-SOC}"
            echo "fan_state=$fan_state"
            echo "fan_target=$fan_state"
            echo "mode=$fan_mode"
            echo "backend=$FAN_BACKEND"
            [ "$FAN_BACKEND" = "gpio" ] && echo "gpio_chip=$GPIO_CHIP" && echo "gpio_line=$GPIO_LINE"
            echo "hdd_monitor=$(normalize_hddmon "${HDD_MONITOR:-auto}")"
            echo "hdd_state=$DISK_READ_STATE"
            echo "disk_max=$dmax"
            echo "$DISK_TEMPS_OUT" | while IFS='=' read -r k v; do
                [ -n "$k" ] && echo "disk_$k=$v"
            done
            echo "ts=$now"
        } > "$STATE_FILE"

        # --- 历史曲线：每 30 周期（约60秒）记一个点，保留 12 小时 ---
        if [ $(( cycle % 30 )) -eq 1 ]; then
            local d1="" d2="" d3="" di=0 dv
            while IFS='=' read -r _ dv; do
                [ -z "$_" ] && continue
                di=$((di+1))
                case $di in 1) d1=$dv;; 2) d2=$dv;; 3) d3=$dv;; esac
            done <<< "$DISK_TEMPS_OUT"
            echo "$now,$temp_f,$gpu_f,$d1,$d2,$d3,$fan_state" >> "$HISTORY_FILE"
            if [ $(( cycle % 600 )) -eq 1 ] && [ -f "$HISTORY_FILE" ]; then
                tail -n 720 "$HISTORY_FILE" > "$HISTORY_FILE.tmp" 2>/dev/null \
                    && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
            fi
        fi

        sleep "$INTERVAL"
    done
}

# 风扇状态文字（0=关 1=开 其他=未知）
fan_state_text() {
    case "$(read_fan)" in
        0) echo "关闭" ;;
        1) echo "开启" ;;
        *) echo "未知" ;;
    esac
}

# ---------- 状态查看 ----------
cmd_status() {
    load_conf
    detect_backend 2>/dev/null
    echo "===== oesp-fanctl 状态 ====="
    case "$FAN_BACKEND" in
        gpio)
            echo "控制后端:  gpio 直控（$GPIO_CHIP line $GPIO_LINE）"
            echo "风扇状态:  $(fan_state_text)  (0=关, 1=开)"
            ;;
        hwmon)
            echo "控制后端:  hwmon（$FAN_NODE）"
            echo "风扇状态:  $(fan_state_text)  (0=关, 非0=开)"
            ;;
        *)
            echo "控制后端:  未找到！";;
    esac
    echo "CPU 温度:  $(get_temp) ℃"
    detect_gpu
    [ -n "$GPU_NODE" ] && echo "${GPU_LABEL:-SOC} 温度:  $(get_gpu_temp) ℃"
    detect_disks
    local hmon; hmon=$(normalize_hddmon "${HDD_MONITOR:-auto}")
    if [ "$hmon" = "off" ]; then
        echo "硬盘温度:  监控已关闭（不影响硬盘休眠）"
    elif [ "${#DISK_SOURCES[@]}" -gt 0 ]; then
        read_disk_temps
        if [ "$DISK_READ_STATE" = "asleep" ]; then
            echo "硬盘温度:  硬盘处于休眠，已跳过读取（不影响休眠）"
        else
            echo "硬盘温度:  $(echo "$DISK_TEMPS_OUT" | tr '\n' ' ')（最高 ${DISK_MAX_TEMP} ℃）"
        fi
    else
        echo "硬盘温度:  无温度源（可 modprobe drivetemp）"
    fi
    if [ -n "$WEB_SOCK" ] || [ -S "${OESP_FANCTL_SOCK:-/nonexistent}" ]; then
        echo "Web 监控:  飞牛桌面点「OESP风扇助手」图标（网关 ${OESP_FANCTL_BASE:-/app/oesp-fanctl}）"
    else
        echo "Web 监控:  http://NAS地址:${WEB_PORT}"
    fi
    case "$(normalize_mode "${FAN_MODE:-auto}")" in
        on)  echo "运行模式:  常开 —— 风扇持续运行，忽略温度判定" ;;
        off) echo "运行模式:  常关 —— 风扇持续停止，忽略温度判定" ;;
        *)   echo "运行模式:  自动温控（按温度启停）" ;;
    esac
    echo "CPU 开启/关闭阈值:  ${TEMP_ON} / ${TEMP_OFF} ℃"
    echo "启停防抖:  高温持续 ${ON_DELAY:-0} 秒才开 / 低温持续 ${OFF_DELAY:-0} 秒才关（中位数滤波 ${TEMP_FILTER:-1} 点）"
    echo "风扇最短运行:  ${MIN_RUN:-0} 秒"
    case "$hmon" in
        off)  echo "硬盘温度监控:  关闭（不读硬盘，硬盘可正常休眠；硬盘通风与硬盘兜底停用）" ;;
        on)   echo "硬盘温度监控:  始终读取（数据最全，但会持续唤醒硬盘，可能影响休眠）" ;;
        *)    echo "硬盘温度监控:  仅唤醒时读取（硬盘休眠时自动跳过，不影响休眠）" ;;
    esac
    echo "硬盘定时通风阈值:  ${HDD_ON_TEMP} ℃（触发后运行 ${HDD_RUN_SECONDS}s，停机间歇 ${HDD_COOLDOWN}s）"
    echo "紧急强制开启:  CPU ${EMERGENCY_TEMP} ℃ / 硬盘 ${DISK_EMERGENCY_TEMP} ℃（兜底保护）"
    if [ -f "$STATE_FILE" ]; then
        echo "----- 守护进程实时状态 -----"
        cat "$STATE_FILE"
    fi
    if pgrep -f "oesp-fanctl daemon" >/dev/null 2>&1; then
        echo "守护进程:  运行中"
    elif systemctl is-active oesp-fanctl.service >/dev/null 2>&1; then
        echo "守护进程:  运行中（systemd: oesp-fanctl.service）"
    else
        echo "守护进程:  未运行"
    fi
}

# ---------- 修改配置 ----------
cmd_set() {
    [ "$(id -u)" -ne 0 ] && exec sudo "$0" set "$@"
    resolve_paths
    [ -f "$CONF" ] || { echo "配置文件 $CONF 不存在，请先安装"; exit 1; }
    local key=$1 val=$2
    local bak; bak=$(mktemp)
    cp "$CONF" "$bak" 2>/dev/null
    # 写单个 key：存在则替换值（保留行尾注释），不存在则追加
    set_kv() {
        if grep -q "^$1=" "$CONF" 2>/dev/null; then
            sed -i "s/^$1=[^[:space:]]*/$1=$2/" "$CONF"
        else
            printf '%s=%s\n' "$1" "$2" >> "$CONF"
        fi
    }
    case "$key" in
        on|TEMP_ON|temp_on)
               [ "$val" -gt 0 ] 2>/dev/null || { rm -f "$bak"; echo "温度需为正整数"; exit 1; }
               sed -i "s/^TEMP_ON=[^[:space:]]*/TEMP_ON=$val/" "$CONF" ;;
        off|TEMP_OFF|temp_off)
               [ "$val" -gt 0 ] 2>/dev/null || { rm -f "$bak"; echo "温度需为正整数"; exit 1; }
               sed -i "s/^TEMP_OFF=[^[:space:]]*/TEMP_OFF=$val/" "$CONF" ;;
        hdd|HDD_ON_TEMP|hdd_on_temp)
               [ "$val" -gt 0 ] 2>/dev/null || { rm -f "$bak"; echo "温度需为正整数"; exit 1; }
               sed -i "s/^HDD_ON_TEMP=[^[:space:]]*/HDD_ON_TEMP=$val/" "$CONF" ;;
        delay|ondelay|offdelay)
               case "$val" in ''|*[!0-9]*) rm -f "$bak"; echo "秒数需为非负整数"; exit 1 ;; esac
               case "$key" in
                   delay)    set_kv ON_DELAY "$val";  set_kv OFF_DELAY "$val" ;;
                   ondelay)  set_kv ON_DELAY "$val" ;;
                   offdelay) set_kv OFF_DELAY "$val" ;;
               esac ;;
        filter)
               case "$val" in ''|*[!0-9]*) rm -f "$bak"; echo "滤波点数需为 1-9 的整数"; exit 1 ;; esac
               [ "$val" -ge 1 ] && [ "$val" -le 9 ] || { rm -f "$bak"; echo "滤波点数需为 1-9"; exit 1; }
               set_kv TEMP_FILTER "$val" ;;
        hddmon|hddmonitor)
               case "$(printf '%s' "$val" | tr 'A-Z' 'a-z')" in
                   auto|on|off) set_kv HDD_MONITOR "$(printf '%s' "$val" | tr 'A-Z' 'a-z')" ;;
                   *) rm -f "$bak"; echo "用法: oesp-fanctl set hddmon <auto|on|off>"; exit 1 ;;
               esac ;;
        mode)  case "$val" in
                   auto|on|off) ;;
                   *) rm -f "$bak"; echo "用法: oesp-fanctl set mode <auto|on|off>"; exit 1 ;;
               esac
               if grep -q '^FAN_MODE=' "$CONF"; then
                   sed -i "s/^FAN_MODE=[^[:space:]]*/FAN_MODE=$val/" "$CONF"
               else
                   printf 'FAN_MODE=%s\n' "$val" >> "$CONF"
               fi ;;
        *) rm -f "$bak"; echo "用法: oesp-fanctl set <on|off|hdd|mode|delay|ondelay|offdelay|filter|hddmon> <值>"; exit 1 ;;
    esac
    # 交叉校验：CPU 开启温度必须高于关闭温度，否则回滚（与 Web 页规则一致）
    local eon eoff
    eon=$(grep -oE '^TEMP_ON=[0-9]+' "$CONF" 2>/dev/null | head -1 | cut -d= -f2)
    eoff=$(grep -oE '^TEMP_OFF=[0-9]+' "$CONF" 2>/dev/null | head -1 | cut -d= -f2)
    if [ -n "$eon" ] && [ -n "$eoff" ] && [ "$eon" -le "$eoff" ]; then
        cp "$bak" "$CONF" 2>/dev/null
        rm -f "$bak"
        echo "错误：CPU 开启温度（${eon}℃）必须高于关闭温度（${eoff}℃），已取消本次修改"
        exit 1
    fi
    rm -f "$bak"
    echo "已更新，守护进程 2 秒内自动生效："
    grep -E "^(FAN_MODE|TEMP_ON|TEMP_OFF|HDD_ON_TEMP|ON_DELAY|OFF_DELAY|TEMP_FILTER|HDD_MONITOR)=" "$CONF"
}

# ---------- 手动测试 ----------
cmd_test() {
    [ "$(id -u)" -ne 0 ] && exec sudo "$0" test "$@"
    detect_backend || { echo "找不到风扇控制通路"; exit 1; }
    case "$1" in
        on)  echo "开启(1) → 后端 $FAN_BACKEND"; set_fan 1; echo "OK，当前读回: $(read_fan)" ;;
        off) echo "关闭(0) → 后端 $FAN_BACKEND"; set_fan 0; echo "OK，当前读回: $(read_fan)" ;;
        *)   echo "用法: oesp-fanctl test <on|off>"; exit 1 ;;
    esac
    echo "注意：守护进程运行时会在下个周期覆盖此值；测试后请用 restore 或重启服务"
}

# ---------- 释放并恢复系统风扇控制（卸载/停用前调用） ----------
cmd_restore() {
    [ "$(id -u)" -ne 0 ] && exec sudo "$0" restore
    # 结束可能残留的 gpioset 进程
    pkill -f "gpioset -m signal $GPIO_CHIP" 2>/dev/null
    # 重新加载 gpio_fan，恢复厂商 60℃ 内核温控
    if restore_gpio_fan; then
        echo "已重新加载 gpio_fan 驱动，恢复系统内核温控（约 60℃ 开启）"
    else
        echo "提示：未能加载 gpio_fan 驱动（可能无此模块），风扇将处于硬件默认状态"
    fi
    # 恢复系统自带 pwm 风扇服务（若存在）
    for svc in pwm-fancontrol.service fan-fullspeed.service; do
        if [ -f "/usr/lib/systemd/system/$svc" ] || [ -f "/etc/systemd/system/$svc" ]; then
            systemctl enable "$svc" 2>/dev/null
            systemctl start "$svc" 2>/dev/null
            echo "已恢复系统服务 $svc"
        fi
    done
}

case "$1" in
    daemon|"") cmd_daemon ;;
    status)    cmd_status ;;
    set)       cmd_set "$2" "$3" ;;
    mode)      cmd_set mode "$2" ;;
    test)      cmd_test "$2" ;;
    restore)   cmd_restore ;;
    log)       resolve_paths; tail -n 30 "$LOG" 2>/dev/null || echo "暂无日志" ;;
    *)         echo "用法: oesp-fanctl <daemon|status|set|mode|test|restore|log>"; exit 1 ;;
esac
